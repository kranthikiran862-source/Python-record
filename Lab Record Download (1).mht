.callout { margin: 1rem 0px; border-left: 4px solid; padding: 12px 16px; border-radius: 6px; }

.callout.tip { border-color: rgb(34, 197, 94); background: rgb(240, 253, 244); }

.callout.info { border-color: rgb(59, 130, 246); background: rgb(239, 246, 255); }

.callout.warn { border-color: rgb(245, 158, 11); background: rgb(255, 251, 235); }

.callout.danger { border-color: rgb(239, 68, 68); background: rgb(254, 242, 242); }

.callout-title { font-weight: 600; margin-bottom: 4px; }

.callout.tip .callout-title { color: rgb(22, 163, 74); }

.callout.info .callout-title { color: rgb(37, 99, 235); }

.callout.warn .callout-title { color: rgb(217, 119, 6); }

.callout.danger .callout-title { color: rgb(220, 38, 38); }

.callout-title::before { font-size: 1rem; line-height: 1; margin-right: 6px; }

.callout.tip .callout-title::before { content: "💡"; }

.callout.info .callout-title::before { content: "ℹ️"; }

.callout.warn .callout-title::before { content: "⚠️"; }

.callout.danger .callout-title::before { content: "🚫"; }

